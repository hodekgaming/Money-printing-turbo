{
  "mcpServers": {
    "perplexity": {
      "type": "http",
      "url": "https://api.perplexity.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${PERPLEXITY_API_KEY:-set-PERPLEXITY_API_KEY}"
      }
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.37.0"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-fc-placeholder}"
      }
    }
  }
}
